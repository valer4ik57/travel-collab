{
  "name": "travel-collab-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "mobile:build": "powershell -ExecutionPolicy Bypass -File ./scripts/mobile-build.ps1",
    "mobile:init": "powershell -ExecutionPolicy Bypass -File ./scripts/mobile-init.ps1",
    "mobile:open": "powershell -ExecutionPolicy Bypass -File ./scripts/mobile-open-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/status-bar": "^7.0.6",
    "axios": "^1.7.9",
    "leaflet": "^1.9.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/leaflet": "^1.9.16",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
