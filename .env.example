# Backend local development
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/travel_collab?sslmode=disable
JWT_SECRET=change_me_to_a_long_random_secret
PORT=8080
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,capacitor://localhost,http://127.0.0.1:5173
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
MAX_REQUEST_BODY_BYTES=1048576

# GitHub OAuth is optional and is not part of the final checked demo scenario.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# Frontend mobile build examples. These are used at Vite build time.
# VITE_API_BASE_URL=http://192.168.1.166:8080/api/v1
# VITE_WS_BASE_URL=ws://192.168.1.166:8080/api/v1/ws
