# Скопируй этот файл в .env.production и замени значения под свой сервер.
# ВАЖНО: в production backend не стартует со слабым JWT_SECRET.

APP_ENV=production

# Домен или IP, по которому будет открываться сервис.
# Для локальной проверки можно поставить: TRAVEL_COLLAB_SITE_ADDRESS=:80
# Для сервера с доменом: TRAVEL_COLLAB_SITE_ADDRESS=travel-collab.example.ru
TRAVEL_COLLAB_SITE_ADDRESS=travel-collab.example.ru
CADDY_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL/PostGIS внутри docker-compose.prod.yml.
POSTGRES_USER=travel_collab
# ВАЖНО: если пароль используется прямо в DATABASE_URL, не добавляй в него @ : / ? # & + = и пробелы.
# Самый простой вариант — длинный пароль только из латинских букв и цифр.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_ALPHANUMERIC_DB_PASSWORD
POSTGRES_DB=travel_collab
DATABASE_URL=postgres://travel_collab:REPLACE_WITH_LONG_ALPHANUMERIC_DB_PASSWORD@postgres:5432/travel_collab?sslmode=disable

# Сгенерируй длинный случайный секрет. Пример PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=REPLACE_WITH_64_RANDOM_CHARACTERS_MINIMUM
PORT=8080

# Для публичного сервера укажи https://домен.
# Для локальной проверки через http://localhost можно временно поставить APP_ENV=development.
FRONTEND_URL=https://travel-collab.example.ru
FRONTEND_URLS=https://travel-collab.example.ru,https://www.travel-collab.example.ru,https://localhost,http://localhost,capacitor://localhost

# Frontend в production обычно ходит на backend через тот же домен и reverse proxy.
VITE_API_BASE_URL=/api/v1
VITE_WS_BASE_URL=

# Базовая защита авторизации.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m
MAX_REQUEST_BODY_BYTES=1048576

# GitHub OAuth сейчас не входит в проверяемый сценарий. Оставь пустым.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
